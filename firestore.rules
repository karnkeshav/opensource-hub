rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // App requests: anyone may submit one well-formed request. Nobody can read, edit or delete
    // them from the website (read them in the Firebase console, or with an admin tool).
    match /requests/{id} {
      allow create: if request.resource.data.keys().hasOnly(['app','details','name','email','uid','createdAt','status'])
        && request.resource.data.app is string
        && request.resource.data.app.size() >= 3 && request.resource.data.app.size() <= 80
        && request.resource.data.details is string && request.resource.data.details.size() <= 1000
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.email is string && request.resource.data.email.size() <= 120
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time
        && (!('uid' in request.resource.data) || (request.auth != null && request.resource.data.uid == request.auth.uid));
      allow read, update, delete: if false;
    }

    // Download clicks: only a signed-in user, only as themselves, only for the fields below.
    // Clicks can't be edited or deleted, and nobody can read them from the website.
    match /downloads/{id} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid','app','createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.app is string && request.resource.data.app.size() <= 80
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
